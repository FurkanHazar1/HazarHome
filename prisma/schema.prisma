generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  categoryId    Int            @id @default(autoincrement()) @map("category_id")
  categoryName  String         @map("category_name") @db.VarChar(100)
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  parentId      Int?           @map("parent_id")
  categoryLevel Int            @default(1) @map("category_level")
  categoryPath  String?        @map("category_path") @db.VarChar(500)
  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [categoryId])
  children      Category[]     @relation("CategoryHierarchy")
  furnitureSets FurnitureSet[]
  furnitures    Furniture[]

  @@index([isActive], map: "idx_categories_active")
  @@index([categoryLevel], map: "idx_categories_level")
  @@index([parentId], map: "idx_categories_parent")
  @@map("categories")
}

model Color {
  colorId            Int                 @id @default(autoincrement()) @map("color_id")
  colorName          String              @unique @map("color_name") @db.VarChar(50)
  colorCode          String?             @map("color_code") @db.VarChar(7)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  furnitureColors    FurnitureColor[]
  furnitureSetColors FurnitureSetColor[]

  @@index([isActive], map: "idx_colors_active")
  @@map("colors")
}

model Property {
  propertyId             Int                    @id @default(autoincrement()) @map("property_id")
  propertyName           String                 @unique @map("property_name") @db.VarChar(50)
  propertyType           String                 @map("property_type") @db.VarChar(30)
  description            String?
  isActive               Boolean                @default(true) @map("is_active")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  furnitureProperties    FurnitureProperty[]
  furnitureSetProperties FurnitureSetProperty[]

  @@map("properties")
}

model Image {
  imageId            Int                 @id @default(autoincrement()) @map("image_id")
  fileName           String              @map("file_name") @db.VarChar(255)
  filePath           String              @map("file_path") @db.VarChar(500)
  fileSize           Int?                @map("file_size")
  fileType           String?             @map("file_type") @db.VarChar(10)
  uploadedAt         DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  description        String?
  isActive           Boolean             @default(true) @map("is_active")
  altText            String?             @map("alt_text") @db.VarChar(255)
  width              Int?
  height             Int?
  originalFileName   String?             @map("original_file_name") @db.VarChar(255)
  sortOrder          Int                 @default(1) @map("sort_order")
  furnitureImages    FurnitureImage[]
  furnitureSetImages FurnitureSetImage[]

  @@index([isActive], map: "idx_images_active")
  @@index([sortOrder], map: "idx_images_sort")
  @@map("images")
}

model Furniture {
  furnitureId         Int                        @id @default(autoincrement()) @map("furniture_id")
  furnitureName       String                     @map("furniture_name") @db.VarChar(100)
  furnitureType       String                     @map("furniture_type") @db.VarChar(50)
  categoryId          Int?                       @map("category_id")
  description         String?
  price               Decimal                    @db.Decimal(12, 2)
  isActive            Boolean                    @default(true) @map("is_active")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  furnitureColors     FurnitureColor[]
  furnitureImages     FurnitureImage[]
  furnitureProperties FurnitureProperty[]
  furnitureSetItems   FurnitureSetAndFurniture[]
  category            Category?                  @relation(fields: [categoryId], references: [categoryId])

  @@index([isActive], map: "idx_furniture_active")
  @@index([categoryId], map: "idx_furniture_category")
  @@index([furnitureType], map: "idx_furniture_type")
  @@map("furnitures")
}

model FurnitureColor {
  id          Int       @id @default(autoincrement())
  furnitureId Int       @map("furniture_id")
  colorId     Int       @map("color_id")
  isAvailable Boolean   @default(true) @map("is_available")
  color       Color     @relation(fields: [colorId], references: [colorId])
  furniture   Furniture @relation(fields: [furnitureId], references: [furnitureId], onDelete: Cascade)

  @@unique([furnitureId, colorId])
  @@index([isAvailable], map: "idx_furniture_colors_available")
  @@map("furniture_colors")
}

model FurnitureProperty {
  id            Int       @id @default(autoincrement())
  furnitureId   Int       @map("furniture_id")
  propertyId    Int       @map("property_id")
  propertyValue String    @map("property_value") @db.VarChar(200)
  isActive      Boolean   @default(true) @map("is_active")
  furniture     Furniture @relation(fields: [furnitureId], references: [furnitureId], onDelete: Cascade)
  property      Property  @relation(fields: [propertyId], references: [propertyId])

  @@index([isActive], map: "idx_furniture_properties_active")
  @@map("furniture_properties")
}

model FurnitureImage {
  id          Int       @id @default(autoincrement())
  furnitureId Int       @map("furniture_id")
  imageId     Int       @map("image_id")
  sortOrder   Int       @default(1) @map("sort_order")
  imageType   String    @default("main_image") @map("image_type") @db.VarChar(30)
  isActive    Boolean   @default(true) @map("is_active")
  furniture   Furniture @relation(fields: [furnitureId], references: [furnitureId])
  image       Image     @relation(fields: [imageId], references: [imageId], onDelete: Cascade)

  @@map("furniture_images")
}

model FurnitureSet {
  setId                  Int                        @id @default(autoincrement()) @map("set_id")
  categoryId             Int                        @map("category_id")
  setName                String?                    @map("set_name") @db.VarChar(150)
  description            String?
  price                  Decimal                    @db.Decimal(12, 2)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  isActive               Boolean                    @default(true) @map("is_active")
  furnitureSetColors     FurnitureSetColor[]
  furnitureSetImages     FurnitureSetImage[]
  furnitureSetProperties FurnitureSetProperty[]
  category               Category                   @relation(fields: [categoryId], references: [categoryId])
  furnitureSetItems      FurnitureSetAndFurniture[]

  @@map("furniture_sets")
}

model FurnitureSetColor {
  id             Int          @id @default(autoincrement())
  furnitureSetId Int          @map("furniture_set_id")
  colorId        Int          @map("color_id")
  isAvailable    Boolean      @default(true) @map("is_available")
  color          Color        @relation(fields: [colorId], references: [colorId])
  furnitureSet   FurnitureSet @relation(fields: [furnitureSetId], references: [setId])

  @@unique([furnitureSetId, colorId])
  @@map("furniture_set_colors")
}

model FurnitureSetProperty {
  id             Int          @id @default(autoincrement())
  furnitureSetId Int          @map("furniture_set_id")
  propertyId     Int          @map("property_id")
  propertyValue  String       @map("property_value") @db.VarChar(200)
  isActive       Boolean      @default(true) @map("is_active")
  furnitureSet   FurnitureSet @relation(fields: [furnitureSetId], references: [setId])
  property       Property     @relation(fields: [propertyId], references: [propertyId])

  @@map("furniture_set_properties")
}

model FurnitureSetImage {
  id             Int          @id @default(autoincrement())
  furnitureSetId Int          @map("furniture_set_id")
  imageId        Int          @map("image_id")
  sortOrder      Int          @default(1) @map("sort_order")
  imageType      String       @default("main_image") @map("image_type") @db.VarChar(30)
  isActive       Boolean      @default(true) @map("is_active")
  furnitureSet   FurnitureSet @relation(fields: [furnitureSetId], references: [setId])
  image          Image        @relation(fields: [imageId], references: [imageId], onDelete: Cascade)

  @@map("furniture_set_images")
}

model FurnitureSetAndFurniture {
  id             Int          @id @default(autoincrement())
  furnitureSetId Int          @map("furniture_set_id")
  furnitureId    Int          @map("furniture_id")
  quantity       Int          @default(1)
  sortOrder      Int          @default(1) @map("sort_order")
  furniture      Furniture    @relation(fields: [furnitureId], references: [furnitureId])
  furnitureSet   FurnitureSet @relation(fields: [furnitureSetId], references: [setId])

  @@map("furniture_sets__and_furniture")
}
